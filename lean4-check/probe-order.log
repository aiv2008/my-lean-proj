== define-derived-mode 的展开顺序 ==
(progn
  (progn
    :autoload-end (defvar foo-x-hook nil)
    (unless (get 'foo-x-hook 'variable-documentation)
      (put 'foo-x-hook 'variable-documentation
	   "Hook run after entering `foo-x'.\nNo problems result if this variable is not bound.\n`add-hook' automatically binds it.  (This is true for all hook variables.)"))
    (unless (boundp 'foo-x-map)
      (put 'foo-x-map 'definition-name 'foo-x))
    (with-no-warnings (defvar-keymap foo-x-map))
    (unless (get 'foo-x-map 'variable-documentation)
      (put 'foo-x-map 'variable-documentation "Keymap for `foo-x'."))
    (progn
      (defvar foo-x-syntax-table)
      (unless (boundp 'foo-x-syntax-table)
	(put 'foo-x-syntax-table 'definition-name 'foo-x)
	(defvar foo-x-syntax-table (make-syntax-table)))
      (unless (get 'foo-x-syntax-table 'variable-documentation)
	(put 'foo-x-syntax-table 'variable-documentation
	     "Syntax table for `foo-x'.")))
    (progn
      (defvar foo-x-abbrev-table)
      (unless (boundp 'foo-x-abbrev-table)
	(put 'foo-x-abbrev-table 'definition-name 'foo-x)
	(defvar foo-x-abbrev-table
	  (progn
	    (define-abbrev-table 'foo-x-abbrev-table nil)
	    foo-x-abbrev-table)))
      (unless (get 'foo-x-abbrev-table 'variable-documentation)
	(put 'foo-x-abbrev-table 'variable-documentation
	     "Abbrev table for `foo-x'.")))
    (if (fboundp 'derived-mode-set-parent)
	(derived-mode-set-parent 'foo-x 'prog-mode)
      (put 'foo-x 'derived-mode-parent 'prog-mode))
    nil)
  (defun foo-x nil
    "Major mode derived from `prog-mode' by `define-derived-mode'.\nIt inherits all of the parent's attributes, but has its own keymap,\nabbrev table and syntax table:\n\n  `foo-x-map', `foo-x-abbrev-table' and `foo-x-syntax-table'\n\nwhich more-or-less shadow prog-mode's corresponding tables.\n\nIn addition to any hooks its parent mode might have run, this mode\nruns the hook `foo-x-hook', as the final or penultimate step during\ninitialization.\n\n\\{foo-x-map}"
    (interactive)
    (delay-mode-hooks
      (prog-mode) (setq major-mode 'foo-x) (setq mode-name "FooX")
      (progn
	(if (get 'prog-mode 'mode-class)
	    (put 'foo-x 'mode-class (get 'prog-mode 'mode-class)))
	(unless (keymap-parent foo-x-map)
	  (set-keymap-parent foo-x-map (current-local-map)))
	(let ((parent (char-table-parent foo-x-syntax-table)))
	  (unless
	      (and parent (not (eq parent (standard-syntax-table))))
	    (set-char-table-parent foo-x-syntax-table (syntax-table))))
	(unless
	    (or (abbrev-table-get foo-x-abbrev-table :parents)
		(eq foo-x-abbrev-table local-abbrev-table))
	  (abbrev-table-put foo-x-abbrev-table :parents
			    (list local-abbrev-table))))
      (use-local-map foo-x-map) (set-syntax-table foo-x-syntax-table)
      (setq local-abbrev-table foo-x-abbrev-table) (foo-body))
    (run-mode-hooks 'foo-x-hook)))

